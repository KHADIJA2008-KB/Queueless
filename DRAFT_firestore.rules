rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidServiceQueue(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.averageServiceTime is number && data.averageServiceTime > 0 &&
             data.currentTokenNumber is number &&
             data.totalTokensIssued is number &&
             data.status in ['open', 'closed'] &&
             data.adminId == request.auth.uid;
    }

    function isValidQueueToken(data) {
      return data.userName is string && data.userName.size() > 0 && data.userName.size() <= 50 &&
             data.userId == request.auth.uid &&
             data.status in ['waiting', 'serving', 'completed', 'cancelled'] &&
             data.tokenNumber is number &&
             data.joinedAt == request.time;
    }

    // --- Collection Routes ---
    match /queues/{queueId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Filtered by status or common access
      
      allow create: if isVerified() && isValidId(queueId) && isValidServiceQueue(incoming());
      
      allow update: if isVerified() && (
        (incoming().adminId == existing().adminId && (
          // Admin action: Next Token
          (incoming().diff(existing()).affectedKeys().hasOnly(['currentTokenNumber'])) ||
          // Admin action: Change status
          (incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
          // General Update (Total Tokens) - triggered on join
          (incoming().diff(existing()).affectedKeys().hasOnly(['totalTokensIssued']))
        ))
      );

      match /tokens/{tokenId} {
        allow get: if isSignedIn() && (existing().userId == request.auth.uid || get(/databases/$(database)/documents/queues/$(queueId)).data.adminId == request.auth.uid);
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/queues/$(queueId)).data.adminId == request.auth.uid);

        allow create: if isVerified() && isValidId(tokenId) && isValidQueueToken(incoming()) &&
                      exists(/databases/$(database)/documents/queues/$(queueId)) &&
                      // Ensure token number matches queue state (optimistic or validated)
                      incoming().tokenNumber == get(/databases/$(database)/documents/queues/$(queueId)).data.totalTokensIssued + 1;

        allow update: if isVerified() && (
          // User action: Cancel
          (existing().userId == request.auth.uid && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
          // Admin action: Serve/Complete
          (get(/databases/$(database)/documents/queues/$(queueId)).data.adminId == request.auth.uid && 
           incoming().status in ['serving', 'completed'] && 
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'servedAt']))
        );
      }
    }
  }
}
